#!/usr/bin/env bash
# Muvrix AppImage runtime entrypoint
set -eo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${HERE}"
# Private media runtime (libmpv 0.42 + ffmpeg + libplacebo) ships inside the
# AppImage. It comes first so the bundled player never mixes with a host
# libmpv of a different client API; glibc and graphics drivers still come from
# the host.
export LD_LIBRARY_PATH="${APPDIR}/usr/lib/muvrix/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export MUVRIX_RUNTIME_MANIFEST="${APPDIR}/usr/lib/muvrix/runtime-manifest.json"
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export MUVRIX_ASSETS_DIR="${APPDIR}/usr/share/muvrix/assets"

# If invoked with --appimage-extract-and-run or directly
if [ -x "${APPDIR}/usr/bin/muvrix" ]; then
    exec "${APPDIR}/usr/bin/muvrix" "$@"
elif [ -x "${APPDIR}/bin/muvrix" ]; then
    exec "${APPDIR}/bin/muvrix" "$@"
else
    echo "Error: Muvrix executable not found in AppDir (${APPDIR})" >&2
    exit 1
fi
