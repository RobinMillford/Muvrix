# Reproducible build environment for the private Muvrix media runtime.
#
# Pinned to a single Ubuntu release so the produced libraries link against a
# known glibc baseline. All build dependencies live in the image, so the runtime
# build itself is a pure git/build operation over pinned sources.
#
# The baseline is Debian 12 (bookworm, glibc 2.36) rather than Ubuntu 24.04
# (2.39). 2.39 excludes Debian 12, Ubuntu 22.04/24.04-pre-update, and every
# distribution older than ~2024. 2.36 is the lowest release that still carries
# the complete dev-dependency set: Ubuntu 22.04 (glibc 2.35) lacks
# libshaderc-dev entirely, and libplacebo is configured with -Dshaderc=enabled.
# Rather than disable a shader compiler the upstream stack enables by default,
# the baseline moves up one notch to the oldest release where nothing has to be
# turned off.
FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        build-essential meson ninja-build pkg-config python3 python3-pip \
        curl ca-certificates xz-utils git \
        libavcodec-dev libavfilter-dev libavformat-dev libavutil-dev libavdevice-dev \
        libswresample-dev libswscale-dev \
        libass-dev liblcms2-dev libvulkan-dev glslang-tools libshaderc-dev \
        libdrm-dev libxkbcommon-dev libwayland-dev wayland-protocols \
        libx11-dev libxext-dev libxfixes-dev libxrandr-dev libxss-dev libxv-dev \
        libxpresent-dev libxcb1-dev libxcb-shm0-dev \
        libarchive-dev libbluray-dev libdvdnav-dev libdvdread-dev libcdio-cdda-dev \
        libcdio-paranoia-dev libuchardet-dev libjpeg-dev libluajit-5.1-dev \
        librubberband-dev zlib1g-dev libzimg-dev libsixel-dev libpulse-dev \
        libasound2-dev libcurl4-openssl-dev libmujs-dev pax-utils \
        libffi-dev libexpat1-dev libxml2-dev && \
    rm -rf /var/lib/apt/lists/*

# Debian 12 ships meson 1.0.1; libplacebo 7.387 requires >= 1.3. Install a
# pinned newer meson from PyPI rather than lowering the project's requirement.
RUN python3 -m pip install --no-cache-dir --break-system-packages 'meson==1.4.2'

WORKDIR /workspace
